# Dataset locations for Open Apero.
#
# Copy this file to `datasets.env` (gitignored) and `source` it before roslaunch:
#
#     cp datasets.env.example datasets.env
#     ${EDITOR:-nano} datasets.env
#     source datasets.env
#
# The scene files these variables feed are roslaunch-templated -- they
# contain $(env ...) / $(find ...) and are loaded with subst_value="true". Load
# them through the launch files in open_apero_ros/launch/. A bare
# `rosparam load config/scenes/HSSD/_common.yaml` stores the substitution
# as a literal string instead of resolving it.

# --- HSSD ------------------------------------------------------------------
# Consumed by open_apero_ros/config/scenes/HSSD/_common.yaml and docker/run.sh --gpu.
# Expected layout:
#   $HSSD_DATA_ROOT/versioned_data/hssd-hab/hssd-hab.scene_dataset_config.json
#   $HSSD_DATA_ROOT/scene_datasets/hssd-hab/stages/
export HSSD_DATA_ROOT=/path/to/hssd
