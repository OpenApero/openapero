<?xml version="1.0"?>
<package format="2">
    <name>open_apero_msgs</name>
    <version>1.0.0</version>
    <description>ROS message definitions for Open Apero</description>

    <author email="kaixqu@ethz.ch">Kaixian Qu</author>

    <maintainer email="kaixqu@ethz.ch">Kaixian Qu</maintainer>

    <license>BSD-3-Clause</license>

    <url type="website">https://openapero.github.io/openapero/</url>
    <url type="repository">https://github.com/OpenApero/openapero</url>
    <url type="bugtracker">https://github.com/OpenApero/openapero/issues</url>

    <buildtool_depend>catkin</buildtool_depend>

    <build_depend>message_generation</build_depend>
    <exec_depend>message_runtime</exec_depend>
    <depend>std_msgs</depend>
    <depend>geometry_msgs</depend>
</package>
