<launch>
  <!-- Absolute path to the bag to replay; run_experiment_sim.launch records into its runs directory,
       <data_root>/<scene_dataset>/<scene_id>/<planner>/open_apero_bag_<timestamp>.bag. -->
  <arg name="bag_path" />
  <!-- Playback rate factor. -->
  <arg name="rate" default="100" />
  <!-- Seconds into the bag to start at. -->
  <arg name="start" default="0.0" />

  <!-- rosbag play publishes the bag's /clock. -->
  <param name="/use_sim_time" value="true"/>

  <node pkg="rosbag" type="play" name="rosbag_play" args="--clock $(arg bag_path) -r $(arg rate) -s $(arg start)" output="screen" />

  <!-- RViz. Without DISABLE_ROS1_EOL_WARNINGS it opens a modal end-of-life dialog and ignores Ctrl+C. -->
  <node type="rviz" name="rviz_experiment" pkg="rviz" args="-d $(find open_apero_ros)/rviz/experiment.rviz">
    <env name="DISABLE_ROS1_EOL_WARNINGS" value="1"/>
  </node>

</launch>
