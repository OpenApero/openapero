# Based on Google style: https://google.github.io/styleguide/cppguide.html
BasedOnStyle: Google
# Maximum line width is 140 characters (default: 80)
ColumnLimit: 140
# Indent of two spaces, no tabs.
IndentWidth: 2
# Always attach braces to surrounding context.
BreakBeforeBraces: Attach
# Force pointer alignment with the type (left).
DerivePointerAlignment: false
PointerAlignment: Left
# Only merge functions defined inside a class.
AllowShortFunctionsOnASingleLine: Inline
# Sort each include block separately and never move includes across blocks.
IncludeBlocks: Preserve
# One category for every include, so each block is sorted alphabetically only
# (CONTRIBUTING.md: the blank-line-separated groups carry the ordering).
IncludeCategories:
  - Regex: '.*'
    Priority: 1
